# Copy to .env.local. Never commit real secrets. No production values in local/staging.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
# A limited, non-owner, NOBYPASSRLS login. Never use the migrator here.
DATABASE_URL=
# Separate owner connection; scripts only, never set on Vercel runtime.
MIGRATION_DATABASE_URL=
# Generated independent password for the limited `tarbiyah_app_runtime` login.
RUNTIME_DATABASE_PASSWORD=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# An actual domain controlled by the operator. No user-facing email requirement.
AUTH_INTERNAL_EMAIL_DOMAIN=
# Generate at least 32 random bytes; only used to HMAC login-attempt identifiers.
AUTH_RATE_LIMIT_SECRET=
# P8 operator-only values. Keep them local; never add them to Vercel Production.
P8_STAGING_SUPABASE_URL=
P8_STAGING_DATABASE_URL=
P8_RECOVERY_DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
P8_SOURCE_PROJECT_REF=
