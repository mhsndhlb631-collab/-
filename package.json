{
  "name": "tarbiyah-operations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:runtime": "node scripts/dev-runtime.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "smoke": "node scripts/artifact-smoke.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "db:setup-runtime": "node --env-file=.env.local scripts/setup-runtime-role.ts",
    "db:verify-runtime": "node --env-file=.env.local scripts/verify-runtime-role.ts",
    "spike:session": "node --env-file=.env.spike.local scripts/session-spike.ts",
    "acceptance:session": "node --env-file=.env.local scripts/run-session-acceptance.ts",
    "acceptance:p1": "node --env-file=.env.local scripts/run-p1-acceptance.ts",
    "acceptance:p2": "node --env-file=.env.local scripts/run-p2-acceptance.ts",
    "acceptance:p3": "node --env-file=.env.local scripts/run-p3-acceptance.ts",
    "acceptance:p4": "node --env-file=.env.local scripts/run-p4-acceptance.ts",
    "acceptance:p5": "node --env-file=.env.local scripts/run-p5-acceptance.ts",
    "acceptance:p6": "node --env-file=.env.local scripts/run-p6-acceptance.ts",
    "acceptance:p7": "node --env-file=.env.local scripts/run-p7-acceptance.ts",
    "acceptance:p8:security": "node --env-file=.env.local scripts/run-p8-security.ts",
    "acceptance:p8:load": "node --env-file=.env.local scripts/run-p8-load.ts",
    "acceptance:p8:recovery": "node --env-file=.env.local scripts/run-p8-recovery.ts",
    "acceptance:p8:environments": "node --env-file=.env.local scripts/run-p8-environment-check.ts",
    "acceptance:offline-mobile": "node scripts/run-offline-mobile-acceptance.mjs",
    "monitor:production": "node scripts/run-p8-monitor.ts",
    "vercel:configure": "node scripts/configure-vercel.ts"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.116.0",
    "dexie": "^4.4.6",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
